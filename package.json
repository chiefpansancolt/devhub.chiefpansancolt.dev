{
  "name": "devhub-chiefpansancolt-dev",
  "version": "1.0.0",
  "private": true,
  "description": "The website for DevHub, a macOS menu bar app that keeps Homebrew, Node and Ruby up to date",
  "author": "chiefpansancolt",
  "repository": {
    "type": "git",
    "url": "https://github.com/chiefpansancolt/devhub.chiefpansancolt.dev"
  },
  "homepage": "https://devhub.chiefpansancolt.dev",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:fix": "prettier --write ."
  },
  "browserslist": "defaults, not ie <= 11",
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "clsx": "^2.1.1",
    "next": "^16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "prettier": "^3.9.8",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "0.35.5"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.3.0",
      "@types/react-dom": "19.3.0"
